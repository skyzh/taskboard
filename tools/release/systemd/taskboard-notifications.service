[Unit]
Description=Deliver signed Taskboard Inbox cues
Requires=taskboard-slot-restore.service
After=taskboard-slot-restore.service

[Service]
Type=simple
UMask=0077
RuntimeDirectory=taskboard-notifications
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 -B %h/.local/share/taskboard/operator/tools/release/operator_deploy.py --config %h/.config/taskboard/deploy.json --run-notification-worker %h/.config/taskboard/notifications.json %t/taskboard-notifications/status.json
Restart=on-failure
RestartSec=10s
TimeoutStopSec=60s

[Install]
WantedBy=default.target
